map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 8080 default_server;
    server_name _;

    root /home/ubuntu/apps/novnc/build;
    index vnc.html index.html;

    # VNC WebSocket endpoints (exact suffix match)
    location ~* ^/(ws|vnc\.html/ws)$ {
        proxy_pass http://127.0.0.1:6900;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;
        tcp_nodelay on;
    }

    # Audio WebSocket endpoints (EXACT URI match so static JS files are never swallowed)
    location = /audio {
        proxy_pass http://127.0.0.1:6090;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;
        tcp_nodelay on;
    }

    location = /live-view-audio {
        proxy_pass http://127.0.0.1:6090;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;
        tcp_nodelay on;
    }

    # Static files with correct MIME types
    location / {
        try_files $uri $uri/ /vnc.html;
    }
}
